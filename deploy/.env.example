# Sub2API Rust/PostgreSQL deployment
#
# Generate independent secrets before first start:
#   openssl rand -hex 32
# Keep this file private after copying it to .env.

SUB2API_RUST_IMAGE=sub2api-rust:local
SUB2API_SOURCE_DIR=..
SUB2API_BUILD_VERSION=development
SUB2API_RUST_BRANCH=main
SUB2API_RUST_ROLLBACK_REFS=

SERVER_PORT=8080
BIND_HOST=0.0.0.0
RUN_MODE=standard
TZ=Asia/Shanghai

POSTGRES_USER=sub2api
POSTGRES_PASSWORD=
POSTGRES_DB=sub2api
DATABASE_MAX_OPEN_CONNS=50
DATABASE_MIN_CONNS=1

JWT_SECRET=
JWT_EXPIRE_HOUR=24
TOTP_ENCRYPTION_KEY=
ADMIN_EMAIL=admin@sub2api.local
ADMIN_PASSWORD=

GATEWAY_MAX_BODY_SIZE=268435456
TRUST_PROXY_HEADERS=false
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=true
SETUP_CONFIG_OVERRIDES_ENV=true
BACKUP_MAX_RESTORE_BYTES=68719476736
RUST_LOG=sub2api_rust=info,tower_http=info

# Optional external PostgreSQL settings for docker-compose.standalone.yml.
# DATABASE_HOST=host.docker.internal
# DATABASE_PORT=5432
# DATABASE_USER=sub2api
# DATABASE_PASSWORD=
# DATABASE_DBNAME=sub2api
# DATABASE_SSLMODE=require

# Optional controlled update hook used by the administrator API.
SUB2API_REDEPLOY_COMMAND=

# Signed model pricing source.
PRICING_REMOTE_URL=https://raw.githubusercontent.com/Wei-Shaw/model-price-repo/main/model_prices_and_context_window.json
PRICING_HASH_URL=https://raw.githubusercontent.com/Wei-Shaw/model-price-repo/main/model_prices_and_context_window.sha256
PRICING_ALLOWED_HOSTS=raw.githubusercontent.com
