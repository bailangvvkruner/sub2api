+func usageLogPendingInstanceKey() string {
+	host, _ := os.Hostname()
+	host = strings.TrimSpace(host)
+	if host == "" {
+		host = "unknown"
+	}
+	return "usage:pending:log:" + host + ":" + strconv.Itoa(os.Getpid())
+}
