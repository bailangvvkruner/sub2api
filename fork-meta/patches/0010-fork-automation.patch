+  contents: read
+
+concurrency:
+  group: fork-patch-validation-${{ github.event.pull_request.number || github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  validate:
+    name: Fork patch validation
+    runs-on: ubuntu-latest
+
+    steps:
+      - name: Checkout candidate
+        uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      - name: Fetch upstream
+        run: |
+          upstream_url="$(jq -er '.upstream_repository' fork-meta/patch-series.json)"
+          upstream_branch="$(jq -er '.upstream_branch' fork-meta/patch-series.json)"
+          git remote add upstream "$upstream_url"
+          git fetch --no-tags upstream "$upstream_branch"
+          echo "UPSTREAM_REF=upstream/$upstream_branch" >>"$GITHUB_ENV"
+
+      - name: Set up Go
+        uses: actions/setup-go@v5
+        with:
+          go-version-file: backend/go.mod
+          cache-dependency-path: backend/go.sum
+
+      - name: Validate manifest and clean-worktree replay
+        run: |
+          jq -e . fork-meta/patch-series.json >/dev/null
+          bash .github/scripts/validate-patch-queue.sh HEAD "$UPSTREAM_REF"
+
+      - name: Verify fork contract
+        run: |
+          bash .github/scripts/verify-fork-hotpath.sh
+          git diff --check
+
+      - name: Run focused backend tests
+        working-directory: backend
+        run: |
+          packages=(./internal/repository ./internal/service ./internal/handler ./internal/server)
+          if [ -d internal/hotpath ]; then
+            packages+=(./internal/hotpath)
+          fi
+          go test "${packages[@]}"
+
+      - name: Set up pnpm
+        uses: pnpm/action-setup@v4
+        with:
+          version: 9
+
+      - name: Set up Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: "20"
+          cache: pnpm
+          cache-dependency-path: frontend/pnpm-lock.yaml
+
+      - name: Install frontend dependencies
+        working-directory: frontend
+        run: |
+          pnpm install --frozen-lockfile
+
+      - name: Typecheck frontend
+        working-directory: frontend
+        run: |
+          pnpm typecheck
+
+      - name: Run frontend tests
+        working-directory: frontend
+        run: |
+          pnpm test:run
