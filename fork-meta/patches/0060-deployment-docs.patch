@@ -441,9 +441,12 @@ gateway:
     # Fallback max waiting queue size
     # 兜底最大排队长度
     fallback_max_waiting: 100
+    # Fallback account selection mode: random or last_used
+    # 兜底账户选择策略：random（默认）或 last_used
+    fallback_selection_mode: random
     # Prefer the account whose session window resets soonest (use-it-or-lose-it).
     # 负载感知选择时优先用尽「会话窗口最早重置」的账号；false 保持
-    # 原有「优先级 → 负载率 → LRU」行为（默认）。
+    # 默认「优先级 → 负载率 → 随机」行为。
     prefer_soonest_reset: false
     # Enable batch load calculation for scheduling
     # 启用调度批量负载计算
@@ -472,6 +475,30 @@ gateway:
     outbox_backlog_rebuild_rows: 10000
     # 全量重建周期（秒），0 表示禁用
     full_rebuild_interval_seconds: 300
+  # Hot-path optimization switches. This fork enables aggressive single-node mode by default.
+  # 热路径优化开关。本 fork 默认开启单机激进模式。
+  hotpath:
+    # Store concurrency slots and wait counters in process memory instead of Redis.
+    # 将并发槽和等待计数放到本机内存，适合单实例部署；多实例会各自放行并发额度。
+    local_concurrency_slots: true
+    # Persist account last_used_at to DB via deferred batch updates.
+    # 是否继续把账号 last_used_at 延迟批量写入数据库；关闭可进一步降低 DB 写入。
+    persist_account_last_used: false
+    # Read/write billing cache through process memory before Redis.
+    # 余额、订阅用量、API key 限速、user×platform quota 先落 sub2api 进程内存，未命中再 Redis。
+    local_billing_cache: true
+    # Max entries per local billing cache bucket before approximate LRU eviction.
+    # 本机计费缓存每类最大条目数，超过后按近似 LRU 淘汰。
+    local_billing_cache_max_entries: 262144
+    # Also write local billing cache mutations through to Redis.
+    # 是否把本机计费热快照的写入同时透传 Redis；单实例 L1 激进模式默认关闭以降低 Redis QPS。
+    local_billing_cache_write_through: false
+    # Batch per-request usage billing in process memory before PostgreSQL.
+    # 请求扣费/用量先进入进程内 write-behind 聚合，再批量刷入 PostgreSQL。
+    usage_billing_write_behind: true
+    # Flush interval for usage billing write-behind (milliseconds).
+    # 请求扣费/用量 write-behind 刷盘间隔（毫秒）。
+    usage_billing_flush_interval_ms: 30000
   # TLS fingerprint simulation / TLS 指纹伪装
   # Default profile "claude_cli_v2" simulates Node.js 20.x
   # 默认模板 "claude_cli_v2" 模拟 Node.js 20.x 指纹
@@ -825,6 +852,15 @@ database:
   # Connection max idle time (minutes)
   # 空闲连接最大存活时间（分钟）
   conn_max_idle_time_minutes: 5
+  # Batch-flush user×platform quota usage snapshots from cache to PostgreSQL.
+  # 将 user×platform 配额用量从缓存批量刷入 PostgreSQL，减少每请求直写 DB。
+  user_platform_quota_flusher_enabled: true
+  # Flush interval for user×platform quota snapshots (milliseconds).
+  # user×platform 配额快照刷盘间隔（毫秒）。
+  user_platform_quota_flush_interval_ms: 30000
+  # Max user×platform quota rows per flush batch.
+  # 单批刷入的 user×platform 配额行数上限，建议不超过 6000。
+  user_platform_quota_flush_batch_size: 1000
 
