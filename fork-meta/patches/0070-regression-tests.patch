+
+	require.NoError(t, cache.SetUserPlatformQuotaCache(ctx, 7, "openai", entry, time.Hour))
+	require.NoError(t, cache.IncrUserPlatformQuotaUsageCache(ctx, 7, "openai", 2.5, time.Hour, true))
