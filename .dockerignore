# =============================================================================
# Docker Ignore File for Sub2API
# =============================================================================

# Git
.git
.gitignore
.gitattributes

# Documentation
*.md
!deploy/DOCKER.md
!backend-rust/docs/
!backend-rust/docs/go-routes.tsv
# admin-compliance gate (LegalDocumentView.vue) build-time imports
# docs/legal/*.md?raw into the frontend bundle; keep that subtree in the
# Docker build context even though docs/ is otherwise excluded.
!docs/legal/
!docs/legal/*.md

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/
frontend-dist/
backend-rust/target/

# Node modules (will be installed in container)
frontend/node_modules/
node_modules/

# Retired backend source is excluded from the production build context.
backend/**

# Test files
**/*.test.js
coverage/
.nyc_output/

# Environment files
.env
.env.*
!.env.example

# Local config
config.yaml
config.local.yaml

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Deploy files (not needed in image)
deploy/install.sh
deploy/sub2api.service
deploy/sub2api-sudoers
deploy/data/
deploy/postgres_data/

# GitHub
.github/

# Claude files
.claude/
issues/
CLAUDE.md
